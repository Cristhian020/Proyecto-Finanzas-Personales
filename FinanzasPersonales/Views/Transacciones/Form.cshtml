@model Transaccion
@{
    var accion = Model.Id == 0 ? "Nueva" : "Editar";
    ViewData["Title"] = $"{accion} transacción";
    var tarjetas = (List<int>)ViewBag.TiposPagoTarjeta;
}

<div class="page-head"><div><h1>@accion transacción @(Model.Id == 0 ? "" : $"No. {Model.Id}")</h1></div></div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Estado" />

            <div class="mb-3">
                <label class="form-label d-block">Tipo de transacción</label>
                <div class="btn-group" role="group" aria-label="Tipo de transacción">
                    <input type="radio" class="btn-check" asp-for="TipoTransaccion" value="Egreso" id="tipoEgreso" />
                    <label class="btn btn-outline-danger" for="tipoEgreso"><i class="bi bi-arrow-up-circle"></i> Egreso</label>
                    <input type="radio" class="btn-check" asp-for="TipoTransaccion" value="Ingreso" id="tipoIngreso" />
                    <label class="btn btn-outline-success" for="tipoIngreso"><i class="bi bi-arrow-down-circle"></i> Ingreso</label>
                </div>
            </div>

            <div class="row">
                @* Sólo el administrador elige el usuario; un usuario normal registra a su nombre. *@
                @if (ViewBag.Usuarios is not null)
                {
                    <div class="col-sm-6 mb-3">
                        <label asp-for="UsuarioId" class="form-label"></label>
                        <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="UsuarioId" class="text-danger"></span>
                    </div>
                }
                <div class="col-sm-6 mb-3">
                    <label asp-for="FechaTransaccion" class="form-label"></label>
                    <input asp-for="FechaTransaccion" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaTransaccion" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3" id="grupoEgreso">
                <label asp-for="EgresoId" class="form-label"></label>
                <select asp-for="EgresoId" asp-items="ViewBag.Egresos" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="EgresoId" class="text-danger"></span>
            </div>
            <div class="mb-3" id="grupoIngreso">
                <label asp-for="IngresoId" class="form-label"></label>
                <select asp-for="IngresoId" asp-items="ViewBag.Ingresos" class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="IngresoId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="TipoPagoId" class="form-label"></label>
                    <select asp-for="TipoPagoId" asp-items="ViewBag.TiposPago" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="TipoPagoId" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3" id="grupoTarjeta">
                    <label asp-for="NoTarjeta" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">**** **** ****</span>
                        <input asp-for="NoTarjeta" class="form-control" maxlength="4" inputmode="numeric" placeholder="1234" />
                    </div>
                    <span asp-validation-for="NoTarjeta" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Monto" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">RD$</span>
                    <input asp-for="Monto" type="number" step="0.01" min="0.01" class="form-control" />
                </div>
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comentario" class="form-label"></label>
                <textarea asp-for="Comentario" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Comentario" class="text-danger"></span>
            </div>

            @if (Model.Id != 0)
            {
                <p class="text-muted small mb-3">Registrada el @Model.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</p>
            }

            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const tiposTarjeta = @Json.Serialize(tarjetas);
            const urlTipoPago = '@Url.Action("TipoPagoDefecto")';
            const egreso = document.getElementById('EgresoId');
            const tipoPago = document.getElementById('TipoPagoId');

            function esEgreso() { return document.getElementById('tipoEgreso').checked; }

            function actualizarTipo() {
                document.getElementById('grupoEgreso').hidden = !esEgreso();
                document.getElementById('grupoIngreso').hidden = esEgreso();
            }

            function actualizarTarjeta() {
                const grupo = document.getElementById('grupoTarjeta');
                const visible = tiposTarjeta.includes(parseInt(tipoPago.value));
                grupo.style.visibility = visible ? 'visible' : 'hidden';
                if (!visible) document.getElementById('NoTarjeta').value = '';
            }

            // Al elegir un gasto se propone su tipo de pago por defecto.
            egreso.addEventListener('change', async function () {
                if (!egreso.value) return;
                const r = await fetch(urlTipoPago + '?egresoId=' + egreso.value);
                const id = await r.json();
                if (id) { tipoPago.value = id; actualizarTarjeta(); }
            });

            document.querySelectorAll('input[name="TipoTransaccion"]').forEach(r => r.addEventListener('change', actualizarTipo));
            tipoPago.addEventListener('change', actualizarTarjeta);
            actualizarTipo();
            actualizarTarjeta();
        })();
    </script>
}
