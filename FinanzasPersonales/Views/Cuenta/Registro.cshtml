@model RegistroViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Crear cuenta";
    ViewData["AuthClass"] = "wide";
}

<div class="card">
    <div class="card-body">
        <h1 class="h4 mb-1">Crear cuenta</h1>
        <p class="text-muted mb-4">Registra tus datos para empezar a controlar tus ingresos y gastos.</p>

        <form asp-action="Registro" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="TipoPersona" class="form-label"></label>
                    <select asp-for="TipoPersona" asp-items="Html.GetEnumSelectList<TipoPersona>()" class="form-select"></select>
                </div>
                <div class="col-sm-7">
                    <label asp-for="Cedula" class="form-label"></label>
                    <input asp-for="Cedula" class="form-control" placeholder="000-0000000-0" />
                    <span asp-validation-for="Cedula" class="text-danger"></span>
                </div>
                <div class="col-sm-7">
                    <label asp-for="LimiteEgresos" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="LimiteEgresos" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="form-text">Te avisaremos cuando tus gastos del mes lo superen.</div>
                    <span asp-validation-for="LimiteEgresos" class="text-danger"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="DiaCorte" class="form-label"></label>
                    <input asp-for="DiaCorte" type="number" min="1" max="28" class="form-control" />
                    <div class="form-text">Día en que cierra tu mes.</div>
                    <span asp-validation-for="DiaCorte" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmarPassword" class="form-label"></label>
                    <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-4">Crear cuenta</button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            ¿Ya tienes cuenta? <a asp-action="Login" class="fw-medium">Iniciar sesión</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
