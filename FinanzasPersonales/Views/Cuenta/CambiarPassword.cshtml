@model CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-head">
    <div>
        <h1>Cambiar contraseña</h1>
        <p>Usa al menos 6 caracteres.</p>
    </div>
</div>

<div class="card form-card" style="max-width: 480px">
    <div class="card-body">
        <form asp-action="CambiarPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Actual" class="form-label"></label>
                <input asp-for="Actual" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="Actual" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nueva" class="form-label"></label>
                <input asp-for="Nueva" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Nueva" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Confirmar" class="form-label"></label>
                <input asp-for="Confirmar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Confirmar" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Actualizar contraseña</button>
            <a asp-action="Perfil" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
