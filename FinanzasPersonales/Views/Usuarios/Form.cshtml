@model Usuario
@{
    var accion = Model.Id == 0 ? "Nuevo" : "Editar";
    ViewData["Title"] = $"{accion} usuario";
}

<div class="page-head">
    <div>
        <h1>@accion usuario</h1>
        <p>Datos personales, acceso y configuración del corte.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="TipoPersona" class="form-label"></label>
                    <select asp-for="TipoPersona" asp-items="Html.GetEnumSelectList<TipoPersona>()" class="form-select"></select>
                </div>
                <div class="col-sm-7">
                    <label asp-for="Cedula" class="form-label"></label>
                    <input asp-for="Cedula" class="form-control" placeholder="000-0000000-0" />
                    <div class="form-text">Física: cédula de 11 dígitos. Jurídica: RNC de 9 dígitos.</div>
                    <span asp-validation-for="Cedula" class="text-danger"></span>
                </div>
                <div class="col-sm-7">
                    <label asp-for="LimiteEgresos" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="LimiteEgresos" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="form-text">Se mostrará un aviso cuando los egresos del mes superen este monto.</div>
                    <span asp-validation-for="LimiteEgresos" class="text-danger"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="DiaCorte" class="form-label"></label>
                    <input asp-for="DiaCorte" type="number" min="1" max="28" class="form-control" />
                    <div class="form-text">Día del mes en que cierra su periodo.</div>
                    <span asp-validation-for="DiaCorte" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h2 class="section-title">Acceso</h2>
            <div class="row g-3">
                <div class="col-sm-7">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-sm-5">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol" asp-items="Html.GetEnumSelectList<Rol>()" class="form-select"></select>
                </div>
                <div class="col-sm-7">
                    <label asp-for="NuevaPassword" class="form-label">@(Model.Id == 0 ? "Contraseña" : "Nueva contraseña")</label>
                    <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
                    @if (Model.Id != 0)
                    {
                        <div class="form-text">Déjela en blanco para conservar la actual.</div>
                    }
                    <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                </div>
                <div class="col-sm-5 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="Estado" class="form-check-input" />
                        <label asp-for="Estado" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
