@model IEnumerable<Catalogo>
@{
    ViewData["Title"] = ViewData["Titulo"];
    ViewData["Subtitulo"] = "Catálogo del sistema.";
}

<partial name="_Buscador" />

<div class="card table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Identificador</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.Estado ? "" : "opacity-50")">
                    <td>@item.Id</td>
                    <td>@item.Descripcion</td>
                    <td><partial name="_Estado" model="item.Estado" /></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
                        <partial name="_BotonEstado" model="(item.Id, item.Estado)" />
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="empty">No hay registros.</td></tr>
            }
        </tbody>
    </table>
</div>
