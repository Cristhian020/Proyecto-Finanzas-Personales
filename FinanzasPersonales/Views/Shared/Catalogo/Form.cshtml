@model Catalogo
@{
    var accion = Model.Id == 0 ? "Nuevo" : "Editar";
    ViewData["Title"] = $"{accion} {ViewData["TituloSingular"]}";
}

<div class="page-head"><div><h1>@accion @(ViewData["TituloSingular"]?.ToString()?.ToLower())</h1></div></div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            @if (Model.Id != 0)
            {
                <div class="mb-3">
                    <label class="form-label">Identificador</label>
                    <input class="form-control" value="@Model.Id" disabled />
                </div>
            }
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" autofocus />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="Estado" class="form-check-input" />
                <label asp-for="Estado" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
