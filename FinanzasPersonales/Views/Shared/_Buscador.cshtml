<div class="page-head">
    <div>
        <h1>@(ViewData["Encabezado"] ?? ViewData["Title"])</h1>
        @if (ViewData["Subtitulo"] is string subtitulo)
        {
            <p>@subtitulo</p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <form asp-action="Index" method="get" class="d-flex gap-2" role="search">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="search" name="buscar" value="@ViewData["Buscar"]" class="form-control border-start-0 ps-0" placeholder="Buscar..." aria-label="Buscar" />
            </div>
        </form>
        <a asp-action="Create" class="btn btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Nuevo</a>
    </div>
</div>
