@model IEnumerable<Ingreso>
@{
    ViewData["Title"] = "Ingresos";
    ViewData["Encabezado"] = "Gestión de ingresos";
    ViewData["Subtitulo"] = "Fuentes de ingreso disponibles al registrar transacciones.";
}

<partial name="_Buscador" />

<div class="card shadow-sm table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Descripción</th>
                <th>Tipo de ingreso</th>
                <th>Institución / Empleador / Cliente</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr class="@(i.Estado ? "" : "opacity-50")">
                    <td>@i.Id</td>
                    <td>@i.Descripcion</td>
                    <td>@i.TipoIngreso?.Descripcion</td>
                    <td>@i.Institucion</td>
                    <td><partial name="_Estado" model="i.Estado" /></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
                        <partial name="_BotonEstado" model="(i.Id, i.Estado)" />
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="empty">No hay ingresos registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
